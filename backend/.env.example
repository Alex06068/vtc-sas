# Copy this file to backend/.env and fill in local values.
# Never commit backend/.env — it is gitignored.

# DeepSeek API key for the chatbot (required for live conversation).
DEEPSEEK_API_KEY=

# Comma-separated school computer addresses or CIDR ranges.
# Leave empty to keep the attendance IP check off (unless rows exist in school_networks).
# SCHOOL_NETWORKS=172.30.82.0/23
SCHOOL_NETWORKS=

# Set to true only when this app sits behind a trusted reverse proxy that
# overwrites/appends X-Forwarded-For. Then the rightmost hop is used.
# Leave false (the default) on a public internet-facing process so clients
# cannot spoof their IP via forwarded headers.
# TRUST_PROXY_HEADERS=false
